# Скопируйте в .env и подставьте значения. Используется бэкендом (корень проекта, npm start).

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/messenger"
REDIS_URL="redis://127.0.0.1:6379"

JWT_ACCESS_SECRET="минимум-32-случайных-символов-замените"
JWT_REFRESH_SECRET="другой-минимум-32-символов-замените"
TOTP_ENCRYPTION_KEY="ещё-один-ключ-минимум-32-символов"

MINIO_ENDPOINT="http://127.0.0.1:9000"
MINIO_ACCESS_KEY="minio"
MINIO_SECRET_KEY="minio123"
MINIO_BUCKET="sf-attachments"

# Публичный URL фронта — первая запись из списка используется в письме сброса пароля
CLIENT_URL="https://sf-communication.ru"

# Почта: без SMTP_HOST письма не отправляются (ссылка сброса пишется только в лог сервера).
SMTP_HOST="smtp.beget.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="ваш_ящик@ваш-домен.ru"
SMTP_PASS="пароль-приложения-или-smtp"
SMTP_FROM="Sales factory <noreply@ваш-домен.ru>"

# Опционально: push через Firebase Cloud Messaging (legacy Server key из консоли Firebase)
FCM_SERVER_KEY=""
