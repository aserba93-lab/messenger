# Скопируйте в web/.env.local (не коммитится) или используйте переменные окружения при сборке.
# Пароли SMTP и т.п. задаются на СЕРВЕРЕ бэкенда (корень репозитория .env), не здесь.

# ОБЯЗАТЕЛЬНО для Android/iOS (Capacitor) и Electron: без этого в оболочке origin localhost — API не найден.
# VITE_API_URL=https://sf-communication.ru
# На сервере в CORS для Capacitor уже добавлены https://localhost и capacitor://localhost (см. dist/server.js).

# ОБЯЗАТЕЛЬНО для сборки установщика Windows (Electron): создайте файл web/.env.production.local
# и впишите РЕАЛЬНЫЙ HTTPS-адрес, где доступен ваш бэкенд (тот же домен что у сайта, без слэша в конце):
# VITE_API_URL=https://sf-communication.ru
# Затем: npm run build && npm run electron:dist
# На сервере в .env бэкенда: CORS_EXTRA_ORIGINS=app://root

# WebRTC / звонки (JSON в одну строку)
VITE_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]

# Опционально: прямые ссылки на установщики при сборке (перекрывают client-downloads.json)
# VITE_DOWNLOAD_WINDOWS_URL=https://example.com/files/Messenger-Setup.exe
# VITE_DOWNLOAD_ANDROID_URL=https://example.com/files/app-release.apk
